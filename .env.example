# Copy this file to .env and fill in real values. .env is gitignored and
# must never be committed.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-side only (read by api/extract-insurance-card.js) -- never exposed
# to the client, never prefix this with VITE_.
GEMINI_API_KEY=
# Optional: override the model (defaults to gemini-3.6-flash). Check your
# AI Studio console for which Flash model your account/free-tier can use --
# gemini-2.5-flash has been retired for newer accounts (Gemini's API returns
# a 404 naming its replacement if you point this at a dead model).
GEMINI_MODEL=

# Server-side only (read by api/chat-confluence.js) -- powers the "Ask
# Confluence" chatbot. Deliberately a separate provider/key from Gemini
# above so card extraction and chat never share a rate limit.
GROQ_API_KEY=
# Optional: override the model (defaults to openai/gpt-oss-120b). Check
# https://console.groq.com for which models your account currently has.
GROQ_MODEL=
